{
  "name": "basmatech-web",
  "private": true,
  "version": "0.1.0",
  "description": "Basma Tech web — monorepo for company site (apps/main) and portfolio walk-through (apps/portfolio)",
  "scripts": {
    "dev": "turbo run dev",
    "dev:main": "turbo run dev --filter=main",
    "dev:portfolio": "turbo run dev --filter=portfolio",
    "build": "turbo run build",
    "build:main": "turbo run build --filter=main",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "ffmpeg-static": "^5.2.0",
    "playwright": "^1.59.1",
    "sharp": "^0.34.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=20"
  }
}
